@model List<Order>

@foreach(var order in Model){
    <div class="card mb-3">
        <div class="card-header">
            <h3>
                @order.StudentName
            </h3>
        </div>
        <div class="card-body">
            <h5 class="card-title">
                @order.MealName <small class="text-body-secondary">- @order.OrderId</small>
            </h5>
            @if(order.Collected){
                <p class="card-text text-success">Collected</p>
            } 
            else{
                <p class="card-text text-danger">Not Collected</p>
            }
            <a href="/orders/details/@order.OrderId" class="btn btn-primary">Details</a>
        </div>
    </div>
}
