@model Order

<div class="card">
    <div class="card-body">
        <h3 class="card-title">@Model.StudentName</h3>
        <p class="card-text">Meal: @Model.MealName</p>
        <p class="card-text">Order Id: @Model.OrderId</p>
        @if(Model.Collected){
            <p class="card-text text-success">Collected</p>
            <p class="card-text">Collected At: @Model.ColledtedAt.ToString()</p>
        }
        else{
            <p class="card-text text-danger">Not Collected</p>
            <p class="card-text">Collected At: Not collected yet !</p>
        }
    </div>
</div>
